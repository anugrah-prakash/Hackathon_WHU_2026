# Add your own key here. This placeholder is not a working API key.
OPENAI_API_KEY=your_openai_api_key_here
# Use an exact model ID available in your OpenAI account.
OPENAI_MODEL=gpt-4.1-mini

# Optional: full path to tesseract.exe if it is not on PATH (Windows).
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# Response timeout in seconds (30–600). No automatic retries are made.
OPENAI_TIMEOUT_SECONDS=180
# Optional administrator-provided CA certificate file for HTTPS inspection.
# OPENAI_CA_BUNDLE=C:/certificates/organisation-root-ca.pem
